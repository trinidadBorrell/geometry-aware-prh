{
  "name": "sae_crosscov_v1",
  "label": "Original→PCA versus SAE→PCA cross-covariance and regularized CCA",
  "evaluation_status": "exploratory_heldout",
  "frozen_before_alignment_scores": true,
  "dataset": "coco_val2017",
  "split_manifest": "data/manifests/coco_val2017_splits.json",
  "caption_reliability_manifest": "results/caption_reliability_filter_v1/manifest.json",
  "caption_cache": "features/coco_val2017_caption_reliability_v1",
  "vision_cache": "features/coco_val2017_final_block_pre_norm",
  "fit_split": "train",
  "eval_split": "test",
  "captions_per_image": 5,
  "caption_rule": "smallest five COCO annotation ids; inherited from caption_reliability_filter_v1",
  "languages": ["qwen2-7b", "olmo-7b-0724"],
  "visions": ["dinov2-small", "vit-in21k-small"],
  "panel_rule": "First language key of each of the two families in the caption-reliability base panel with complete five-caption caches (Qwen→qwen2-7b, OLMo→olmo-7b-0724). First two vision anchors that are not language_supervised (dinov2-small, vit-in21k-small). Chosen before this experiment's alignment scores.",
  "pilot_pair": ["qwen2-7b", "dinov2-small"],
  "stability_pair": ["qwen2-7b", "dinov2-small"],
  "primary_sae_seed": 0,
  "stability_sae_seeds": [1, 2],
  "inner_fit_fraction": 0.8,
  "inner_split_seed": 20261019,
  "clip_q": 0.95,
  "clip_rule": "exact order statistic int(0.95*numel) on train-only features; never test",
  "row_normalization": "L2 after clipping, before SAE and PCA",
  "pca_dimensions": [32, 64, 128],
  "pca_rank_tol": 1e-8,
  "sae": {
    "kind": "topk",
    "dictionary_width": 2048,
    "topk": 32,
    "activation": "relu_then_topk",
    "loss": "mse_reconstruction",
    "decoder_unit_columns": true,
    "optimizer": "adam",
    "learning_rate": 0.001,
    "batch_size": 256,
    "max_epochs": 40,
    "patience": 5,
    "min_delta": 1e-5,
    "weight_decay": 0.0
  },
  "eta_primary": 0.01,
  "eta_grid": [0.001, 0.01, 0.1],
  "support_tol": 1e-8,
  "prefixes": [1, 4, 8, 16, 32],
  "shuffle_seeds": [11, 23, 37, 51, 73],
  "subsample_indices": "results/caption_reliability_filter_v1/subsample_indices.npy",
  "output": "results/sae_crosscov_v1"
}
